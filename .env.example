APP_NAME=LaraDogs
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# APP_URL/APP_PORT below are the `docker compose up` defaults (see
# docker-compose.yml and docs/development/docker.md). APP_PORT only
# changes the HOST-published port — the app inside the container always
# listens on :8000 regardless. Not used by `php artisan serve` (Without
# Docker — see docs/development/setup.md), which always binds to :8000.
APP_URL=http://localhost:17347
APP_PORT=17347

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Quick Start default: SQLite (zero configuration). MySQL, MariaDB
# (DB_CONNECTION=mariadb), and PostgreSQL (DB_CONNECTION=pgsql) are
# equally supported — see docs/architecture/decisions/ADR-0007-database-agnostic-persistence.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Docker self-hosted UAT profile (docker-compose.yml's dedicated,
# isolated `db` MySQL service) --------------------------------------------
# To use it instead of SQLite: comment out DB_CONNECTION=sqlite above,
# then uncomment this block. DB_HOST/DB_PORT here are the INTERNAL Docker
# network address LaraDogs itself connects through — never change DB_PORT
# to match APP_DATABASE_PORT below, they are unrelated.
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=laradogs
# DB_USERNAME=laradogs
# DB_PASSWORD=laradogs
# Only used by the `db` container itself at first startup (MySQL
# initialization) — LaraDogs' own application connection never uses root.
# DB_ROOT_PASSWORD=laradogs_root
#
# Optional: publish the `db` container's MySQL port to the HOST (e.g. to
# inspect it with a local GUI client). This does NOT affect DB_PORT above —
# LaraDogs always talks to MySQL over the Docker network via
# DB_HOST=db/DB_PORT=3306, never through this port. Only relevant when the
# Docker MySQL profile above is active.
# APP_DATABASE_PORT=17348
# Alternative host DB port if 17348 is already occupied by something else:
# APP_DATABASE_PORT=13306

# Host directory of Laravel projects for LaraDogs to audit — bind-mounted
# READ-ONLY at the fixed container path /projects (see docker-compose.yml
# and docs/self-hosting.md). Defaults to ./projects (relative to the repo,
# auto-created empty by Docker) so a fresh checkout works with zero
# configuration; point this at a real directory to see projects in the
# Dashboard's "Add Project" picker. NEVER commit a real value here beyond
# this example — set the real path only in your own local, gitignored
# `.env`.
LARADOGS_PROJECTS_PATH=./projects
# LARADOGS_PROJECTS_PATH=/absolute/path/to/your/projects

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The first LaraDogs administrator is provisioned by running
# `docker compose exec app php artisan laradogs:user:create-admin`, which
# prompts interactively (hidden password input) — this is the recommended
# path, and needs nothing set here. LARADOGS_ADMIN_NAME/_EMAIL/_PASSWORD
# below are ONLY for scripted/non-interactive first-boot automation; if
# unset (the default), the command always prompts. LaraDogs never ships or
# auto-creates a default admin account/password — see docs/self-hosting.md.
# LARADOGS_ADMIN_NAME=
# LARADOGS_ADMIN_EMAIL=
# LARADOGS_ADMIN_PASSWORD=
